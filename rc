# =====================================================================
# HTTP
# =====================================================================
def parse_path(req):
    try:
        return req.split(" ")[1]
    except:
        return "/"

def http_send(client, body, ctype):
    client.send((
        "HTTP/1.1 200 OK\r\n"
        "Content-Type: " + ctype + "\r\n"
        "Connection: close\r\n"
        "Cache-Control: no-store\r\n\r\n"
    ).encode())
    client.send(body.encode())

def start_server():
    s = socket.socket()
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        s.settimeout(0.001)
    except:
        pass
    s.bind(("0.0.0.0", PORT))
    s.listen(1)
    return s

def handle_api(path):
    global running, mode, manual_cmd

    if path.startswith("/api/toggle_run"):
        running = not running
        return '{"ok":true,"running":%s}' % ("true" if running else "false")

    elif path.startswith("/api/mode"):
        value = get_query_param(path, "set", "MANUAL")
        if value == "AUTO":
            mode = "AUTO"
        else:
            mode = "MANUAL"
        return '{"ok":true,"mode":"%s"}' % mode

    elif path.startswith("/api/cmd"):
        value = get_query_param(path, "set", "STOP")
        if value in (
            "FORWARD", "BACKWARD", "LEFT", "RIGHT",
            "FORWARD_LEFT", "FORWARD_RIGHT",
            "BACK_LEFT", "BACK_RIGHT",
            "STOP"
        ):
            manual_cmd = value
        else:
            manual_cmd = "STOP"
        return '{"ok":true,"cmd":"%s"}' % manual_cmd

    elif path.startswith("/api/status"):
        return '{"running":%s,"mode":"%s","sensor":%d,"cmd":"%s"}' % (
            "true" if running else "false",
            mode,
            sensor_value,
            manual_cmd
        )

    return '{"ok":false}'

def poll_server(server):
    try:
        cl, addr = server.accept()
    except:
        return

    try:
        try:
            cl.settimeout(0.001)
        except:
            pass

        req = cl.recv(512).decode()
        path = parse_path(req)

        if path.startswith("/api/"):
            body = handle_api(path)
            http_send(cl, body, "application/json")
        else:
            http_send(cl, html_page(), "text/html")
    except Exception as e:
        print("HTTP fout:", e)

    try:
        cl.close()
    except:
        pass

# =====================================================================
# MANUAL BESTURING
# =====================================================================
def update_manual():
    # W = vooruit
    if manual_cmd == "FORWARD":
        set_motors(BASE_LEFT, BASE_RIGHT)
        set_led(True)

    # S = achteruit
    elif manual_cmd == "BACKWARD":
        set_motors(BACKWARD_LEFT, BACKWARD_RIGHT)
        set_led(True)

    # A = links om eigen as
    elif manual_cmd == "LEFT":
        set_motors(BACKWARD_LEFT, BASE_RIGHT)
        set_led(True)

    # D = rechts om eigen as
    elif manual_cmd == "RIGHT":
        set_motors(BASE_LEFT, BACKWARD_RIGHT)
        set_led(True)

    # W + A = vooruit links
    elif manual_cmd == "FORWARD_LEFT":
        set_motors(BASE_LEFT - TURN_STEP, BASE_RIGHT)
        set_led(True)

    # W + D = vooruit rechts
    elif manual_cmd == "FORWARD_RIGHT":
        set_motors(BASE_LEFT, BASE_RIGHT + TURN_STEP)
        set_led(True)

    # S + A = achteruit links
    elif manual_cmd == "BACK_LEFT":
        set_motors(BACKWARD_LEFT, BACKWARD_RIGHT - TURN_STEP)
        set_led(True)

    # S + D = achteruit rechts
    elif manual_cmd == "BACK_RIGHT":
        set_motors(BACKWARD_LEFT + TURN_STEP, BACKWARD_RIGHT)
        set_led(True)

    else:
        stop()
        set_led(False)

# =====================================================================
# AUTO LINE-FOLLOW (OMGEKEERD)
# zwart = rechtdoor
# wit = sturen + LED knipper
# =====================================================================
def follow_line_inverted(sensor):
    if limit_low <= sensor <= limit_high:
        drive_forward()
        set_led(False)

    elif sensor < limit_low:
        set_motors(TURN_RIGHT_SEARCH[0], TURN_RIGHT_STRONG[1])
        toggle_led_blink(120)
        wait_ms(100)

        set_motors(TURN_LEFT_SEARCH[0], TURN_LEFT_STRONG[1])
        toggle_led_blink(120)
        wait_ms(200)

    else:
        set_motors(TURN_LEFT_STRONG[0], TURN_LEFT_STRONG[1])
        toggle_led_blink(120)

# =====================================================================
# START
# =====================================================================
