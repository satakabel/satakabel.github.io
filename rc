# =====================================================================
# KANAALMAPPING
# =====================================================================
CH_LEFT   = 0
CH_SENSOR = 1
CH_LED    = 2
CH_RIGHT  = 3
CH_SW1    = 4

# =====================================================================
# INSTELLINGEN
# =====================================================================
SERVO_STOP = 90

# vooruit
BASE_LEFT  = 130
BASE_RIGHT = 50

# achteruit
BACKWARD_LEFT  = 50
BACKWARD_RIGHT = 130

# bochtsterkte handmatig
TURN_STEP = 25

# auto line-follow
TURN_LEFT_STRONG  = (140, 60)
TURN_RIGHT_STRONG = (120, 80)

TURN_LEFT_SEARCH  = (140, -140)
TURN_RIGHT_SEARCH = (-140, 140)

limit_low  = 210
limit_high = 225

# wifi
WIFI_SSID = "AIVD"
WIFI_PASS = "jemoeder"
PORT = 8080

