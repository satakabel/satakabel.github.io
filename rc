mode = "MANUAL"
manual_cmd = "STOP"

lastSw1 = False
lastBlink = 0
ledState = False
sensor_value = 0

# =====================================================================
# INIT
# =====================================================================
kart = stamp.get(stamp.EXT_IO, (0, 26))
kart.init_i2c_address(0x45)

kart.set_config_mode(CH_LEFT, 3)
kart.set_config_mode(CH_SENSOR, 2)
kart.set_config_mode(CH_LED, 1)
kart.set_config_mode(CH_RIGHT, 3)
kart.set_config_mode(CH_SW1, 0)

# =====================================================================
# BASISFUNCTIES
# =====================================================================
def clamp(angle):
    return max(0, min(180, int(angle)))

def set_motors(left_angle, right_angle):
    kart.write_servo_angle(CH_LEFT, clamp(left_angle))
    kart.write_servo_angle(CH_RIGHT, clamp(right_angle))

def stop():
    set_motors(SERVO_STOP, SERVO_STOP)

def drive_forward():
    set_motors(BASE_LEFT, BASE_RIGHT)

def drive_backward():
    set_motors(BACKWARD_LEFT, BACKWARD_RIGHT)

def set_led(v):
    kart.write_output_pin(CH_LED, 1 if v else 0)

def toggle_led_blink(interval_ms):
    global lastBlink, ledState
    now = ticks_ms()
    if ticks_diff(now, lastBlink) > interval_ms:
        ledState = not ledState
        set_led(ledState)
        lastBlink = now

def button_pressed():
    global lastSw1
    state = kart.read_input_pin(CH_SW1)

    if state and not lastSw1:
        lastSw1 = True
        wait_ms(120)
        return True
    elif not state:
        lastSw1 = False

    return False

# =====================================================================
# WIFI
# =====================================================================
def connect_wifi():
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)

    if not wlan.isconnected():
        wlan.connect(WIFI_SSID, WIFI_PASS)
        while not wlan.isconnected():
            wait_ms(100)

    return wlan

def url_decode(s):
    s = s.replace("+", " ")
    parts = s.split("%")
    if len(parts) == 1:
        return s

    out = parts[0]
    for p in parts[1:]:
        try:
            out += chr(int(p[:2], 16)) + p[2:]
        except:
            out += "%" + p
    return out

def get_query_param(path, name, default=""):
    if "?" not in path:
        return default

    query = path.split("?", 1)[1]
    pairs = query.split("&")

    for pair in pairs:
        if "=" in pair:
            k, v = pair.split("=", 1)
            if k == name:
                return url_decode(v)

    return default

