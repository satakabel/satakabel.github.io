def wait_ms(ms):
    try:
        time.sleep_ms(ms)
    except:
        time.sleep(ms / 1000)

try:
    ticks_ms = time.ticks_ms
    ticks_diff = time.ticks_diff
except:
    def ticks_ms():
        return int(time.time() * 1000)
    def ticks_diff(a, b):
        return a - b

