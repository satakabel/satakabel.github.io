except:
    pass

server = start_server()

# =====================================================================
# LOOP
# =====================================================================
while True:
    poll_server(server)

    if button_pressed():
        running = not running
        print("RUNNING =", running)

        if not running:
            stop()
            set_led(False)

    if running:
        if mode == "AUTO":
            sensor_value = kart.read_adc8_pin(CH_SENSOR)
            follow_line_inverted(sensor_value)
        else:
            update_manual()
    else:
        stop()
        set_led(False)

    wait_ms(5)
